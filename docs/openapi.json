{
    "openapi": "3.0.0",
    "info": {
        "title": "Newdich Accounts API Endpoints",
        "description": "This endpoint handles everything that has to do with users account across all Newdich Portal",
        "version": "1.0.0"
    },
    "paths": {
        "/register": {
            "post": {
                "summary": "This endpoint creates account for user on Newdich Platform",
                "operationId": "de19eb8060b5681f54fb679bd5901763",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "fullName",
                                    "password",
                                    "username",
                                    "country",
                                    "phoneNumber",
                                    "whatsAppNumber",
                                    "dateRegistered",
                                    "lastSeen",
                                    "gender",
                                    "address"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "newdichuser@gmail.com"
                                    },
                                    "fullName": {
                                        "type": "string",
                                        "example": "newdich technology"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "********"
                                    },
                                    "username": {
                                        "type": "string",
                                        "example": "newdich"
                                    },
                                    "country": {
                                        "type": "string",
                                        "example": "Nigeria"
                                    },
                                    "phoneNumber": {
                                        "type": "string",
                                        "example": "+4409372827"
                                    },
                                    "whatsAppNumber": {
                                        "type": "string",
                                        "example": "+44272927829"
                                    },
                                    "dateRegistered": {
                                        "type": "string",
                                        "example": "2025-08-03 12:45:55"
                                    },
                                    "lastSeen": {
                                        "type": "string",
                                        "example": "2025-08-03 12:45:55"
                                    },
                                    "gender": {
                                        "type": "string",
                                        "example": "male"
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "10, mungo park, London"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful response"
                    }
                }
            }
        },
        "/update": {
            "post": {
                "summary": "This endpoints updates users account",
                "operationId": "6b6474ecb594191a4ef1c8b6df92eb94",
                "responses": {
                    "200": {
                        "description": "array"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "summary": "This endpoint log user in to Newdich Platforms",
                "operationId": "94e9955e6ea14a4ff2a8ada0c2be1478",
                "responses": {
                    "200": {
                        "description": "array"
                    }
                }
            }
        },
        "/profile": {
            "post": {
                "summary": "This endpoint retrieves users profile on Newdich Technology",
                "operationId": "5648efe6bacd4b2404a9fc079600cf76",
                "responses": {
                    "200": {
                        "description": "array"
                    }
                }
            }
        }
    }
}